---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FloatingNav } from "../components/floating-nav";
import { WorksCarousel } from "../components/works-carousel";
import { site } from "../dto/site.dto";
import { socialLinks, type SocialIcon } from "../dto/socials.dto";
import { experiences } from "../dto/experiences.dto";
import { testimonials } from "../dto/recommendations";
import { loadCertificateImages } from "../lib/load-certificate-images";
import { loadGalleryImages } from "../lib/load-gallery";
import { loadProjects } from "../lib/load-projects";

const brandIconSrc = (icon: SocialIcon) =>
  `/assets/icons/${icon}-dark.svg`;

const connectUtilityIconSrc = (icon: "email" | "contact") =>
  icon === "email" ? "/assets/icons/mail.svg" : "/assets/icons/contact.svg";

const projects = loadProjects();
const galleryImages = loadGalleryImages();
const certificateImages = loadCertificateImages();
---

<BaseLayout
  title={site.name}
  description={site.tagline}
>
  <Fragment slot="head">
    {
      projects.map((project) => (
        <link rel="preload" as="image" href={project.cover} />
      ))
    }
  </Fragment>
  <div class="site">
    <main class="site-main">
      <header class="intro">
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p class="tagline">{site.focus}</p>
      </header>

      <section class="connect" aria-labelledby="connect-heading">
        <h2 id="connect-heading">
          Connect <span class="connect-heading-muted">with me</span>
        </h2>
        <ul class="connect-links">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="connect-link"
                  aria-label={social.label}
                  target={social.external ? "_blank" : undefined}
                  rel={social.external ? "noopener noreferrer" : undefined}
                >
                  {social.icon === "email" || social.icon === "contact" ? (
                    <img
                      class="connect-icon connect-icon--brand"
                      src={connectUtilityIconSrc(social.icon)}
                      alt=""
                      width="20"
                      height="20"
                    />
                  ) : (
                    <img
                      class="connect-icon connect-icon--brand"
                      src={brandIconSrc(social.icon)}
                      alt=""
                      width="20"
                      height="20"
                    />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <section class="works" aria-labelledby="works-heading">
      <div class="works-heading-wrap">
        <h2 id="works-heading">Works</h2>
      </div>
      <WorksCarousel client:load projects={projects} />
    </section>

    <footer class="site-footer">
      <p class="site-footer-lead">
        I'm always open to commission, co-development, and career opportunities.
      </p>
      <p class="site-footer-copy">
        <span class="site-footer-copy-icon" aria-hidden="true">©</span>
        <span>2026 Paolo Araneta</span>
      </p>
    </footer>

    <FloatingNav
      client:load
      galleryImages={galleryImages}
      experiences={experiences}
      certificateImages={certificateImages}
      testimonials={testimonials}
    />
  </div>
</BaseLayout>
