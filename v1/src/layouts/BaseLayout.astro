---
import "../styles/global.css";
import "../styles/backdrop-filter-fix.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Paolo Araneta",
  description =
    "Full-stack software engineer based in Cebu, focused on practical web systems, automation workflows, and AI-assisted product development.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/my_profile_pic.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-canvas text-primary font-sans antialiased">
    <slot />
  </body>
</html>
